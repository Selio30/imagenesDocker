# ==========================================
# ⚙️ CONFIGURACIÓN DE VAULTWARDEN
# ==========================================
# Fija la versión de la imagen para estabilidad
VAULTWARDEN_TAG=1.30.5

# Token de acceso al panel de administración (/admin)
# ¡Usa 'make generate-secret' para crear uno fuerte!
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Desactivar el registro público por seguridad (Tú invitas a los usuarios)
SIGNUPS_ALLOWED=false

# ==========================================
# 🗄️ BASE DE DATOS (MARIADB)
# ==========================================
DB_USER=vaultwarden
DB_NAME=vaultwarden
# Contraseña root de MariaDB (separada de la de la app por seguridad)
# ¡Usa 'make generate-secret' para crearla!
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# Contraseña de la base de datos para la app vaultwarden
# ¡Usa 'make generate-secret' para crearla!
DB_PASSWORD=CHANGE_ME_DB_PASSWORD